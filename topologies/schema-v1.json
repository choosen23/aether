{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aether.local/topologies/schema-v1.json",
  "title": "Aether Topology Schema v1",
  "type": "object",
  "required": [
    "schema_version",
    "topology_id",
    "generated_at",
    "nodes",
    "links"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "topology_id": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string"
    },
    "nodes": {
      "type": "array",
      "minItems": 1
    },
    "links": {
      "type": "array",
      "minItems": 1
    }
  },
  "additionalProperties": true
}
