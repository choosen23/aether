REDPANDA_VERSION=v24.2.16
REDPANDA_BROKERS=redpanda:9092
REDPANDA_AIRCRAFT_TOPIC=aircraft.position.v1
REDPANDA_MOBILITY_DENSITY_TOPIC=mobility.density.v1
REDPANDA_DEMAND_REGION_TOPIC=demand.region.v1

REDIS_URL=redis://redis:6379/0
REDIS_NAMESPACE=aether

OPEN_SKY_BASE_URL=https://opensky-network.org/api
OPEN_SKY_POLL_INTERVAL_SECONDS=60
OPEN_SKY_REQUEST_TIMEOUT_SECONDS=10
OPEN_SKY_CLIENT_ID=
OPEN_SKY_CLIENT_SECRET=
EUROPE_MIN_LAT=34.0
EUROPE_MIN_LON=-11.0
EUROPE_MAX_LAT=72.0
EUROPE_MAX_LON=32.0

AETHER_SOURCE_MODE=opensky
AETHER_ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3001
SOURCE_LIVE_MAX_AGE_SECONDS=75
SOURCE_OFFLINE_MAX_AGE_SECONDS=180
AIRCRAFT_REMOVAL_SECONDS=180
REMOVAL_INTERVAL_SECONDS=5
HEARTBEAT_SECONDS=15
INGESTOR_METRICS_PORT=9101
STATE_BUILDER_METRICS_PORT=9102
DENSITY_BUILDER_METRICS_PORT=9103
H3_RESOLUTION=4
AGGREGATION_WINDOW_SECONDS=180
EMIT_INTERVAL_SECONDS=10
AIRBORNE_WEIGHT=1.0
ON_GROUND_WEIGHT=0.35

NEXT_PUBLIC_API_HTTP_URL=http://localhost:8000
NEXT_PUBLIC_API_WS_URL=ws://localhost:8000
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/dark

API_PORT=8000
WEB_PORT=3001
PROMETHEUS_PORT=9090
